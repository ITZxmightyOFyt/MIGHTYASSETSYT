<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090610">
<title>MIGHTY ASSETS — Creator Resource Hub</title>
<style>
:root{--bg:#090610;--panel:#130d20;--panel2:#1a1129;--purple:#9b5cff;--violet:#6d35c9;--text:#f6f0ff;--muted:#aa9dbb;--line:#302044;--pink:#d17cff}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse at 75% -10%,#301451 0,transparent 38%),var(--bg);color:var(--text);font-family:Inter,Segoe UI,Arial,sans-serif;min-height:100vh}
button,input,select,textarea{font:inherit}button{cursor:pointer}.topbar{position:sticky;top:0;z-index:10;background:#0b0712eF;backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}
.nav{max-width:1180px;margin:auto;padding:15px 22px;display:flex;align-items:center;gap:24px}.brand{font-weight:950;letter-spacing:2px;font-size:21px;text-decoration:none;color:white}.brand span{color:var(--purple)}.navlinks{display:flex;gap:20px;margin-left:auto}.navlinks a{color:var(--muted);text-decoration:none;font-size:14px}.navlinks a:hover{color:white}.navbtn{border:1px solid #68409b;background:#211333;color:white;border-radius:10px;padding:10px 14px}
main{max-width:1180px;margin:auto;padding:0 22px}.hero{padding:76px 0 42px;display:grid;grid-template-columns:1.3fr .7fr;gap:30px;align-items:center}.eyebrow{color:#c59aff;font-size:12px;font-weight:800;letter-spacing:3px;text-transform:uppercase}.hero h1{font-size:clamp(42px,7vw,76px);line-height:.98;margin:16px 0;letter-spacing:-3px}.hero h1 span{color:var(--purple);text-shadow:0 0 30px #8d48ff66}.hero p{color:var(--muted);line-height:1.7;max-width:610px;font-size:16px}.hero-card{border:1px solid #59377d;background:linear-gradient(145deg,#28133f,#120c1d 70%);border-radius:24px;padding:26px;box-shadow:0 20px 70px #0008;position:relative;overflow:hidden}.hero-card:after{content:"";position:absolute;width:180px;height:180px;border-radius:50%;background:#9b5cff33;filter:blur(35px);right:-50px;top:-50px}.hero-card strong{font-size:14px;letter-spacing:2px;color:#d8baff}.hero-card .big{font-size:54px;font-weight:900;margin:18px 0 5px}.hero-card small{color:var(--muted)}.searchwrap{margin:15px 0 38px;display:flex;gap:10px}.search{flex:1;background:#130d20;border:1px solid var(--line);border-radius:14px;padding:16px 18px;color:white;outline:none}.search:focus{border-color:var(--purple);box-shadow:0 0 0 3px #9b5cff22}.sectionhead{display:flex;justify-content:space-between;align-items:end;margin:28px 0 18px}.sectionhead h2{margin:0;font-size:25px}.sectionhead p{margin:5px 0 0;color:var(--muted);font-size:13px}.categories{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.cat{background:linear-gradient(140deg,#1d1230,#110b1b);border:1px solid var(--line);border-radius:17px;padding:20px;text-align:left;color:white;transition:.2s}.cat:hover,.asset:hover{transform:translateY(-3px);border-color:#8051b8}.cat .emoji{font-size:25px}.cat b{display:block;margin:12px 0 4px}.cat small{color:var(--muted)}.toolbar{display:flex;gap:10px;flex-wrap:wrap}.filter{background:#160e23;color:#d9c9ed;border:1px solid var(--line);border-radius:10px;padding:9px 13px}.filter.active{background:#5c2b91;border-color:#a66cff;color:white}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:60px}.asset{background:var(--panel);border:1px solid var(--line);border-radius:17px;overflow:hidden;transition:.2s}.preview{height:175px;background:linear-gradient(135deg,#2a1642,#100b18);display:flex;align-items:center;justify-content:center;overflow:hidden;color:#c7a4f2;font-size:42px}.preview img,.preview video{width:100%;height:100%;object-fit:cover}.assetbody{padding:15px}.tag{font-size:10px;text-transform:uppercase;letter-spacing:1.3px;color:#c79cff;font-weight:800}.asset h3{margin:7px 0;font-size:17px}.asset p{font-size:12px;color:var(--muted);line-height:1.5;min-height:34px}.assetfoot{display:flex;justify-content:space-between;align-items:center;margin-top:14px}.download{background:linear-gradient(100deg,#7939c7,#a75cff);color:white;border:0;border-radius:10px;padding:10px 14px;font-weight:800;text-decoration:none;font-size:13px}.empty{grid-column:1/-1;border:1px dashed #49315e;border-radius:16px;padding:35px;text-align:center;color:var(--muted)}
.admin{background:linear-gradient(145deg,#171022,#100a19);border:1px solid var(--line);border-radius:20px;padding:22px;margin:10px 0 65px}.adminhead{display:flex;justify-content:space-between;align-items:center;gap:10px}.admin h2{margin:0}.admin p{color:var(--muted);font-size:13px;line-height:1.6}.adminform{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:18px}.field{display:flex;flex-direction:column;gap:6px}.field.full{grid-column:1/-1}.field label{font-size:12px;color:#cbb8e2}.field input,.field select,.field textarea{background:#0c0812;border:1px solid var(--line);border-radius:10px;padding:12px;color:white;min-width:0}.field textarea{min-height:75px;resize:vertical}.primary{background:#8b48d6;color:white;border:0;border-radius:10px;padding:12px 16px;font-weight:800}.hint{font-size:11px!important;color:#8f80a1!important}.hidden{display:none!important}footer{border-top:1px solid var(--line);padding:25px 22px;text-align:center;color:#8e809d;font-size:12px}
@media(max-width:760px){.hero{grid-template-columns:1fr;padding-top:48px}.hero-card{display:none}.categories{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:repeat(2,1fr)}.navlinks{display:none}.adminform{grid-template-columns:1fr}.field.full{grid-column:auto}}
@media(max-width:480px){.grid{grid-template-columns:1fr}.hero h1{letter-spacing:-2px}.sectionhead{align-items:start;flex-direction:column;gap:12px}}
</style>
</head>
<body>
<header class="topbar"><nav class="nav">
<a class="brand" href="#">MIGHTY <span>ASSETS</span></a>
<div class="navlinks"><a href="#explore">Explore</a><a href="#library">Library</a><a href="#admin">Add assets</a></div>
<button class="navbtn" onclick="document.querySelector('#library').scrollIntoView({behavior:'smooth'})">Browse assets ↗</button>
</nav></header>
<main>
<section class="hero">
<div><div class="eyebrow">The creator resource hub</div><h1>MAKE YOUR<br>EDITS <span>STAND OUT.</span></h1>
<p>MIGHTY ASSETS is a growing library of scene packs, overlays, wallpapers and audio for creators. Explore the collection, find your next creative spark, and download assets in a click.</p>
<button class="primary" onclick="document.querySelector('#explore').scrollIntoView({behavior:'smooth'})">Explore collection ↓</button>
</div>
<div class="hero-card"><strong>BUILT FOR CREATORS</strong><div class="big">M/A</div><small>SCENE PACKS · OVERLAYS · WALLPAPERS · AUDIO</small></div>
</section>
<div class="searchwrap"><input id="search" class="search" type="search" placeholder="Search scene packs, overlays, wallpapers, audio..." aria-label="Search assets"><button class="navbtn" onclick="document.querySelector('#search').value='';render()">Clear</button></div>
<section id="explore">
<div class="sectionhead"><div><h2>Explore</h2><p>Jump into a category and discover something new.</p></div></div>
<div class="categories">
<button class="cat" onclick="setCategory('Scene Packs')"><span class="emoji">🎬</span><b>Scene Packs</b><small>Clips and scenes for edits</small></button>
<button class="cat" onclick="setCategory('Overlays')"><span class="emoji">✨</span><b>Overlays</b><small>Effects and visual layers</small></button>
<button class="cat" onclick="setCategory('Wallpapers')"><span class="emoji">🌌</span><b>Wallpapers</b><small>Backgrounds for every screen</small></button>
<button class="cat" onclick="setCategory('Audio')"><span class="emoji">🎧</span><b>Audio</b><small>Sounds and music resources</small></button>
</div>
</section>
<section id="library">
<div class="sectionhead"><div><h2>Asset library</h2><p id="count">Browse the latest resources.</p></div><div class="toolbar" id="filters">
<button class="filter active" data-cat="All">All</button><button class="filter" data-cat="Scene Packs">Scene Packs</button><button class="filter" data-cat="Overlays">Overlays</button><button class="filter" data-cat="Wallpapers">Wallpapers</button><button class="filter" data-cat="Audio">Audio</button>
</div></div>
<div class="grid" id="assets"></div>
</section>
<section id="admin" class="admin">
<div class="adminhead"><div><h2>Asset manager</h2><p>Add your own resources by pasting a direct file link. New entries appear in the public library on this browser.</p></div><button class="navbtn" id="toggleAdmin">＋ Add asset</button></div>
<div id="adminContent" class="hidden">
<form id="assetForm" class="adminform">
<div class="field"><label for="title">Asset title</label><input id="title" required placeholder="e.g. Cinematic Spider-Man Pack"></div>
<div class="field"><label for="category">Category</label><select id="category"><option>Scene Packs</option><option>Overlays</option><option>Wallpapers</option><option>Audio</option></select></div>
<div class="field full"><label for="fileUrl">Direct file URL (download link)</label><input id="fileUrl" type="url" required placeholder="https://example.com/your-file.mp4"></div>
<div class="field full"><label for="previewUrl">Preview image/video URL (optional)</label><input id="previewUrl" type="url" placeholder="https://example.com/preview.jpg"></div>
<div class="field full"><label for="description">Short description</label><textarea id="description" placeholder="Tell visitors what this asset contains..."></textarea></div>
<div class="field full"><button class="primary" type="submit">Publish asset to this browser</button><p class="hint">Use a direct, publicly accessible file URL. A normal webpage/share-page URL may open a preview instead of downloading. Only upload or share files you own or have permission to distribute.</p></div>
</form>
</div>
</section>
</main>
<footer>© <span id="year"></span> MIGHTY ASSETS · Made for creators, by creators.</footer>
<script>
const starter = [
 {id:1,title:"Cinematic Scene Pack",category:"Scene Packs",url:"",preview:"",description:"Your next edit starts here. Add your own scene-pack link in Asset Manager."},
 {id:2,title:"Glow & Light Overlays",category:"Overlays",url:"",preview:"",description:"Layer up your edits with visual effects. Add a download link to publish."},
 {id:3,title:"Dark Purple Wallpaper",category:"Wallpapers",url:"",preview:"",description:"A dark aesthetic background for your setup. Replace this sample with your file."},
 {id:4,title:"Creator Audio Pack",category:"Audio",url:"",preview:"",description:"Sound resources for your next project. Add your own audio link."}
];
let assets;
try{assets=JSON.parse(localStorage.getItem("mightyAssets")||"null")||starter}catch(e){assets=starter}
let activeCategory="All";
const icons={"Scene Packs":"🎬","Overlays":"✨","Wallpapers":"🌌","Audio":"🎧"};
function save(){try{localStorage.setItem("mightyAssets",JSON.stringify(assets))}catch(e){alert("Browser storage is full. Try using smaller preview links.")}}
function setCategory(c){activeCategory=c;document.querySelectorAll(".filter").forEach(b=>b.classList.toggle("active",b.dataset.cat===c));render();document.querySelector("#library").scrollIntoView({behavior:"smooth"})}
document.querySelectorAll(".filter").forEach(b=>b.addEventListener("click",()=>setCategory(b.dataset.cat)));
document.querySelector("#search").addEventListener("input",render);
function safeUrl(s){try{const u=new URL(s);return ["http:","https:"].includes(u.protocol)?u.href:""}catch(e){return ""}}
function render(){
 const q=document.querySelector("#search").value.toLowerCase().trim();
 const shown=assets.filter(a=>(activeCategory==="All"||a.category===activeCategory)&&(`${a.title} ${a.category} ${a.description||""}`).toLowerCase().includes(q));
 document.querySelector("#count").textContent=`${shown.length} resource${shown.length===1?"":"s"} found`;
 const root=document.querySelector("#assets");root.innerHTML="";
 if(!shown.length){root.innerHTML='<div class="empty">No assets found. Try another search or category.</div>';return}
 shown.forEach(a=>{
  const card=document.createElement("article");card.className="asset";
  const preview=document.createElement("div");preview.className="preview";
  const p=safeUrl(a.preview);
  if(p&&/\.(mp4|webm|ogg)(\?|#|$)/i.test(p)){const v=document.createElement("video");v.src=p;v.muted=true;v.controls=true;v.preload="metadata";preview.append(v)}
  else if(p){const im=document.createElement("img");im.src=p;im.alt=a.title+" preview";im.loading="lazy";im.onerror=()=>{preview.textContent=icons[a.category]||"✦"};preview.append(im)}
  else preview.textContent=icons[a.category]||"✦";
  const body=document.createElement("div");body.className="assetbody";
  const tag=document.createElement("div");tag.className="tag";tag.textContent=a.category;
  const h=document.createElement("h3");h.textContent=a.title;
  const d=document.createElement("p");d.textContent=a.description||"Explore this creator resource.";
  const foot=document.createElement("div");foot.className="assetfoot";
  const kind=document.createElement("small");kind.style.color="var(--muted)";kind.textContent="MIGHTY RESOURCE";
  if(a.url){const link=document.createElement("a");link.className="download";link.href=safeUrl(a.url)||"#";link.target="_blank";link.rel="noopener noreferrer";link.download="";link.textContent="Download ↓";if(!safeUrl(a.url)){link.removeAttribute("href");link.textContent="Link unavailable"}foot.append(kind,link)}
  else{const sample=document.createElement("small");sample.style.color="var(--muted)";sample.textContent="Sample card · add your link";foot.append(kind,sample)}
  body.append(tag,h,d,foot);card.append(preview,body);root.append(card);
 });
}
document.querySelector("#toggleAdmin").addEventListener("click",()=>{const c=document.querySelector("#adminContent");c.classList.toggle("hidden");document.querySelector("#toggleAdmin").textContent=c.classList.contains("hidden")?"＋ Add asset":"− Close"});
document.querySelector("#assetForm").addEventListener("submit",e=>{
 e.preventDefault();const url=safeUrl(document.querySelector("#fileUrl").value);if(!url){alert("Please enter a valid http or https file link.");return}
 const preview=safeUrl(document.querySelector("#previewUrl").value);
 assets.unshift({id:Date.now(),title:document.querySelector("#title").value.trim(),category:document.querySelector("#category").value,url,preview,description:document.querySelector("#description").value.trim()});
 save();e.target.reset();render();alert("Asset added on this browser. To publish it for everyone, connect this page to a shared database or edit the website source.");document.querySelector("#adminContent").classList.add("hidden");document.querySelector("#toggleAdmin").textContent="＋ Add asset";
});
document.querySelector("#year").textContent=new Date().getFullYear();render();
</script>
</body></html>
